#!/usr/bin/env bash
# ccchiefctl — small terminal helpers for the cc-chief harness.
# It captures and edits the product features from the shell — the flat, numbered list
# of big cross-cutting capabilities at the product root — so you don't have to edit
# features.md by hand. More helpers may be added over time.
set -eu

usage() {
  cat <<'EOF'
ccchiefctl — small helpers for the cc-chief harness

Usage: ccchiefctl <command>

The product features are features.md at the product root: a flat, numbered list of
big cross-cutting capabilities, one per line ("N. [ ] ..."). The list is declarative
and only accumulates: a shipped capability is marked "[x]" and never deleted.

Commands:
  add <text>       Append "N. [ ] <text>" to the features (numbered next)
  view             Print the product features to the console
  next             Print the first unchecked ("[ ]") item — the frontier
  done <n>         Mark item <n> done ("[x]")
                   There is no drop or prune — features are never deleted.
  renumber         Renumber items to 1..N in order (fixes gaps and old "- [ ]" bullets)
  help             Show this help

ccchiefctl finds the product root (the nearest ancestor holding a top-level
features.md) from the current directory or any parent, so it works from anywhere
inside the product.
EOF
}

# Walk up to the product root — the nearest ancestor holding a top-level features.md
# (the product's own features, beside the product CLAUDE.md).
find_product_root() {
  local dir="$PWD"
  while :; do
    if [ -f "$dir/features.md" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    [ "$dir" = "/" ] && return 1
    dir="$(dirname "$dir")"
  done
}

# Print the product features path, or exit 1 with a hint to run /chief-init.
require_features() {
  local dir
  if ! dir="$(find_product_root)"; then
    echo "ccchiefctl: no product features.md found in '$PWD' or any parent." >&2
    echo "Run /chief-init at the product root to create it." >&2
    exit 1
  fi
  printf '%s\n' "$dir/features.md"
}

# Highest leading "N." number among the features' items (0 if none).
max_num() {
  awk '
    { s = $0; sub(/^[[:space:]]+/, "", s) }
    s ~ /^[0-9]+\.[[:space:]]+\[[ xX]\]/ {
      num = s + 0
      if (num > max) max = num
    }
    END { print max + 0 }
  ' "$1"
}

# Append "N. [ ] <text>" to the features, numbered next (highest + 1). Insert it right
# after the last existing item, or at end of file if there are none yet.
add_item() {
  local text="$1" file="$2" num bullet tmp
  num=$(( $(max_num "$file") + 1 ))
  bullet="$num. [ ] $text"
  tmp="$(mktemp)"
  BULLET="$bullet" awk '
    function is_item(l,   s) {
      s = l; sub(/^[[:space:]]+/, "", s)
      return s ~ /^([0-9]+\.|[-*])[[:space:]]+\[[ xX]\]/
    }
    { lines[NR] = $0; if (is_item($0)) last = NR }
    END {
      for (i = 1; i <= NR; i++) {
        print lines[i]
        if (i == last) print ENVIRON["BULLET"]
      }
      if (last == "") print ENVIRON["BULLET"]
    }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
  printf '%s\n' "$bullet"
}

# Renumber every item to a contiguous 1..N in document order — converts old "- [ ]"
# bullets and closes gaps; the checkbox state is preserved. (The item regex is inlined
# literally — passing it via `awk -v` would mangle the \[ \] escapes.)
renumber() {
  local file="$1" tmp
  tmp="$(mktemp)"
  awk '
    /^[[:space:]]*(([0-9]+\.)|[-*])[[:space:]]+\[[ xX]\]/ {
      count++
      line = $0
      sub(/^[[:space:]]*(([0-9]+\.)|[-*])[[:space:]]+/, "", line)
      print count ". " line
      next
    }
    { print }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

# Flip item <num> from "[ ]" to "[x]". Prints changed | already | notfound.
mark_done() {
  local num="$1" file="$2" tmp st status
  tmp="$(mktemp)"; st="$(mktemp)"
  awk -v num="$num" -v st="$st" '
    !found && /^[[:space:]]*[0-9]+\.[[:space:]]+\[[ xX]\]/ {
      s = $0; sub(/^[[:space:]]*/, "", s)
      if ((s + 0) == num) {
        found = 1
        if ($0 ~ /\[ \]/) { sub(/\[ \]/, "[x]"); changed = 1 }
      }
    }
    { print }
    END { print (found ? (changed ? "changed" : "already") : "notfound") > st }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
  status="$(cat "$st")"; rm -f "$st"
  printf '%s\n' "$status"
}

# Print the first unchecked ("[ ]") item — the frontier, verbatim.
show_next() {
  local file="$1" line
  line="$(awk '/^[[:space:]]*(([0-9]+\.)|[-*])[[:space:]]+\[ \]/ { print; exit }' "$file")"
  if [ -n "$line" ]; then
    printf '%s\n' "$line"
  else
    echo "ccchiefctl: no open ([ ]) items in the product features."
  fi
}

case "${1:-help}" in
  add)
    shift || true
    text="$*"
    if [ -z "$text" ]; then
      echo "ccchiefctl: 'add' needs some text to record." >&2
      exit 2
    fi
    file="$(require_features)"
    added="$(add_item "$text" "$file")"
    echo "Added to $file:"
    echo "  $added"
    ;;
  view)
    file="$(require_features)"
    cat -- "$file"
    ;;
  next)
    file="$(require_features)"
    show_next "$file"
    ;;
  done)
    num="${2:-}"
    case "$num" in
      ''|*[!0-9]*) echo "ccchiefctl: 'done' needs a numeric item number." >&2; exit 2 ;;
    esac
    file="$(require_features)"
    status="$(mark_done "$num" "$file")"
    case "$status" in
      changed)  echo "Marked #$num done." ;;
      already)  echo "#$num was already done." ;;
      notfound) echo "ccchiefctl: no item #$num." >&2; exit 1 ;;
    esac
    ;;
  drop|prune)
    echo "ccchiefctl: features are never deleted — mark them done instead." >&2
    exit 2
    ;;
  renumber)
    file="$(require_features)"
    renumber "$file"
    echo "Renumbered the product features."
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    echo "ccchiefctl: unknown command '$1'" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
